# Supabase — used for reader analytics.
# Get these from your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Password for the /dashboard analytics view.
# This is read on the client, so treat it as a light gate, not real security.
NEXT_PUBLIC_DASHBOARD_PASSWORD=changeme
