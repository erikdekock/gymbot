# ---------------------------------------------------------------------------
#  Supabase — auth, reading position, events, questions.
#  Settings → API in your Supabase project.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY — never prefix with NEXT_PUBLIC_ and never expose to the browser.
# Used by the dashboard route handlers (which read every reader's data) and by
# "Vergeet mij" to delete an auth user. Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
#  Dashboard gate. Server-side only: the password is checked in a route handler
#  and the resulting cookie is httpOnly.
# ---------------------------------------------------------------------------
DASHBOARD_PASSWORD=changeme

# ---------------------------------------------------------------------------
#  Resend — questions, feedback and survey notifications.
#  resend.com → API Keys.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Where reader questions land (your inbox).
AUTHOR_EMAIL=jij@hetzal.nl
# Must be on a domain you verified in Resend.
MAIL_FROM=Het Zal <post@hetzal.nl>
